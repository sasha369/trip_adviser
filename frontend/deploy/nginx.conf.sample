# Образец конфига Nginx для prod-сборки SPA (architecture.md §6).
#
# frontend/ НЕ живёт в Django-шаблонах: React-SPA собирается через
# `npm run build` (получается frontend/dist/), а Nginx раздаёт статику
# и проксирует /api на Django. Точка монтирования dist — '/usr/share/nginx/html'. В docker-compose это обычно multi-stage build:
#   stage 1: node:20 → npm ci && npm run build → /app/dist
#   stage 2: nginx:alpine → COPY --from=1 /app/dist /usr/share/nginx/html
#
# Важно: try_files ... /index.html — обязательный SPA history-fallback,
# иначе прямое открытие /login или обновление страницы выдаст 404.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- SPA: раздать статику, все прочие пути отдать на index.html ---
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- API: reverse-proxy на Django (main_app) ---
    location /api/ {
        proxy_pass http://backend:8000;   # имя сервиса в docker-compose
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # request_id из логов фронта прокидывается в бэкенд для склейки (§9)
        proxy_set_header X-Request-Id $http_x_request_id;
    }

    # --- Медиа (uploads) — Django-папка MEDIA_ROOT, общий volume ---
    location /media/ {
        alias /var/www/media/;
        expires 7d;
    }

    # --- Кэширование хэшированных ассетов Vite ---
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
